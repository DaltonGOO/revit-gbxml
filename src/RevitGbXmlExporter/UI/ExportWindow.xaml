<Window x:Class="RevitGbXmlExporter.UI.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export gbXML for HAP Carrier"
        Width="460" Height="720"
        MinWidth="400" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F0F0F0">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="8,6,8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="0,4,0,4"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">

        <!-- Bottom buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Export" Width="100" Height="30"
                    IsDefault="True" Click="OnExportClick"
                    FontWeight="SemiBold" Margin="0,0,8,0"/>
            <Button Content="Cancel" Width="80" Height="30"
                    IsCancel="True"/>
        </StackPanel>

        <!-- Scrollable content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- Source -->
                <GroupBox Header="Source">
                    <StackPanel>
                        <CheckBox x:Name="CbUseLink" Content="Pull geometry from a linked model"
                                  Checked="OnUseLinkChanged" Unchecked="OnUseLinkChanged"/>
                        <Grid Margin="20,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Link:" Grid.Column="0"/>
                            <ComboBox x:Name="CbLinkInstance" Grid.Column="1"
                                      Height="24" Margin="0,2"
                                      IsEnabled="False"
                                      DisplayMemberPath="DisplayName"/>
                        </Grid>
                        <CheckBox x:Name="CbSpacesFromCurrent"
                                  Content="Use rooms/spaces from current model (recommended)"
                                  Margin="20,0,0,0"
                                  IsChecked="True"
                                  IsEnabled="False"/>
                    </StackPanel>
                </GroupBox>

                <!-- Spatial Elements -->
                <GroupBox Header="Spatial Elements">
                    <StackPanel>
                        <RadioButton x:Name="RbRooms" Content="Rooms (Architectural)"
                                     IsChecked="True" GroupName="SpatialSource"/>
                        <RadioButton x:Name="RbSpaces" Content="MEP Spaces"
                                     GroupName="SpatialSource"/>
                        <Separator Margin="0,6,0,6"/>
                        <CheckBox x:Name="CbPlenumSpaces" Content="Include Plenum Spaces"
                                  IsChecked="True"/>
                    </StackPanel>
                </GroupBox>

                <!-- Surfaces -->
                <GroupBox Header="Surfaces">
                    <StackPanel>
                        <CheckBox x:Name="CbExteriorWalls" Content="Exterior Walls"
                                  IsChecked="True"/>
                        <CheckBox x:Name="CbInteriorWalls" Content="Interior Walls"
                                  IsChecked="True"/>
                        <CheckBox x:Name="CbRoofs" Content="Roofs"
                                  IsChecked="True"/>
                        <CheckBox x:Name="CbFloors" Content="Floors"
                                  IsChecked="True"/>
                        <CheckBox x:Name="CbCeilings" Content="Ceilings"
                                  IsChecked="True"/>
                        <CheckBox x:Name="CbUnderground" Content="Underground Surfaces"
                                  IsChecked="True"/>
                        <CheckBox x:Name="CbShade" Content="Shade Surfaces"/>
                    </StackPanel>
                </GroupBox>

                <!-- Openings -->
                <GroupBox Header="Openings">
                    <StackPanel>
                        <CheckBox x:Name="CbWindows" Content="Windows"
                                  IsChecked="True"/>
                        <CheckBox x:Name="CbDoors" Content="Doors"
                                  IsChecked="True"/>
                        <CheckBox x:Name="CbSkylights" Content="Skylights"
                                  IsChecked="True"/>
                    </StackPanel>
                </GroupBox>

                <!-- Properties -->
                <GroupBox Header="Properties">
                    <StackPanel>
                        <CheckBox x:Name="CbConstructions" Content="Constructions and Materials"
                                  IsChecked="True"/>
                        <CheckBox x:Name="CbWindowTypes" Content="Window Thermal Properties"
                                  IsChecked="True"/>
                        <CheckBox x:Name="CbSpaceLoads" Content="Space Loads (people, lighting, equipment)"/>
                    </StackPanel>
                </GroupBox>

                <!-- Building Settings -->
                <GroupBox Header="Building Settings">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Building Type:" Grid.Column="0"/>
                        <ComboBox x:Name="CbBuildingType" Grid.Column="1"
                                  Height="24" Margin="0,2"/>
                    </Grid>
                </GroupBox>

                <!-- Units -->
                <GroupBox Header="Units">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Content="Temperature:" Grid.Row="0" Grid.Column="0"/>
                        <ComboBox x:Name="CbTemperature" Grid.Row="0" Grid.Column="1"
                                  Height="24" Margin="0,2"/>

                        <Label Content="Length:" Grid.Row="0" Grid.Column="3"/>
                        <ComboBox x:Name="CbLength" Grid.Row="0" Grid.Column="4"
                                  Height="24" Margin="0,2"/>
                    </Grid>
                </GroupBox>

                <!-- Output File -->
                <GroupBox Header="Output File">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TbFilePath" Grid.Column="0"
                                 Height="24" VerticalContentAlignment="Center"
                                 Margin="0,0,8,0"/>
                        <Button Content="Browse..." Grid.Column="1"
                                Width="75" Height="24"
                                Click="OnBrowseClick"/>
                    </Grid>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
